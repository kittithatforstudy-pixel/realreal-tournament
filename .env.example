# Database (Supabase or any PostgreSQL) — used by Prisma (migrations / seed)
DATABASE_URL="postgresql://user:password@localhost:5432/realreal_tournament"

# Supabase JS SDK (used by API routes at runtime)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Discord
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RealReal Tournament"

# File Upload (Cloudinary unsigned upload preset)
# How to get these:
#   1. Sign up free at https://cloudinary.com
#   2. Dashboard → copy "Cloud name"
#   3. Settings → Upload → Add upload preset → Signing Mode: Unsigned → Save
#   4. Copy the preset name
# If both are empty, slip/avatar/banner inputs fall back to a plain URL field.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
