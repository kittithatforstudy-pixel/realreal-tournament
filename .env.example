# Database (Supabase or any PostgreSQL) — used by Prisma (migrations / seed)
DATABASE_URL="postgresql://user:password@localhost:5432/realreal_tournament"

# Supabase JS SDK (used by API routes at runtime)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Discord
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RealReal Tournament"

# File Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
